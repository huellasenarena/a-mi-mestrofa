\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Qu\'e9 edificio tan hermoso
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y tan bien amurallado,
\f2\fs29\fsmilli14667 \cf0 \

