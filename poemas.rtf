\f2\fs28 \cf0 \cb3 \expnd0\expndtw0\kerning0
T\'edtulo: Despierta en ese borde de la ma\'f1ana\cb1 \
\cb3 que la divide de los dem\'e1s\cb1 \
\cb3 cuando no se asoma a la ventana\cb1 \
\cb3 pero sabe que ah\'ed abajo\cb1 \
\cb3 el perro encorreado\cb1 \
\cb3 la mam\'e1 con el ni\'f1o\cb1 \
\cb3 la mujer y una cafeter\'eda siempre igual.\cb1 \
\cb3 Ese borde que la rompe\cb1 \
\cb3 para llevarla al lugar\cb1 \
\cb3 de los nombres quir\'fargicos, psiqui\'e1tricos,\cb1 \
\cb3 de las pastillas que no va a tomar.\cb1 \
\cb3 \'bfAcaso es tan dif\'edcil entender\cb1 \
\cb3 que ah\'ed abajo las ra\'edces\cb1 \
\cb3 del r\'edo te tragan? \'bfPor qu\'e9\cb1 \
\cb3 no ver la evidencia, el rastro\cb1 \
\cb3 rojo amarronado en el cemento,\cb1 \
\cb3 en los ojos, en los cap\'f3s?\cb1 \
\cb3 La luz gris entra por la ventana\cb1 \
\cb3 y, ay, c\'f3mo acercarse siquiera\cb1 \
\cb3 a ese d\'eda vulgar.\
\
T\'edtulo: 
\f3\b\fs34\fsmilli17333 \cf5 TERREMOTO\
\
\pard\pardeftab720\partightenfactor0

\f0\b0 \cf5 Una triste carmelita
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de coraz\'f3n ajetreado
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 discurre de aquesta suerte
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para distraerse en algo.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Qu\'e9 tristes son los asuntos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que se nos han presentado
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en el discurso de un a\'f1o
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 al pie del Monte Calvario.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Ellos han sido capaces
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de que una muda as\'ed hable,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues creo que hasta las bestias
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 hablaran, si fuera dable.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 En el veinte y seis de marzo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 la tierra se estremeci\'f3,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de mis ochocientos doce;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'a1qu\'e9 espanto, qu\'e9 admiraci\'f3n!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Todos los templos se vieron
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 destruidos: \'a1qu\'e9 confusi\'f3n!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'a1Los templos que en este d\'eda
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 es toda nuestra atenci\'f3n!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 La Majestad, que all\'ed expuesta
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 con magnificencia estaba,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 se vio en este momento
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en la tierra sepultada.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Muchos d\'edas se pasaron
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y creo que a\'fan semanas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 sin poderse descubrir,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 por diligencias que se hagan.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Ha sido crecido el n\'famero
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de los que all\'ed sepultados
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 se vieron entre las ruinas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en este momento juzgados.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Los templos, calles y casas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y toda nuestra ciudad
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 cementerios se volvieron
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 por los que all\'ed sepultados
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en este d\'eda se vieron.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 No se oyen m\'e1s que lamentos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en la hermosa Venezuela,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y solo por ser cristiano
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 este golpe resistieron.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 As\'ed es que no se oye
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 entre sus tristes querellas,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 sino una conformidad
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que enternecer\'e1 las piedras.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 La Justicia determina,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para preservar los vivos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que unas hogueras se formen
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para quemar los difuntos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que estaban entre las ruinas.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'a1Oh, qu\'e9 campo tan abierto
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 nos queda a los que esto vimos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 del mundo y todas sus cosas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues no pueden subsistirnos!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Se vieron muchas se\'f1oras
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de las que el mundo segu\'edan
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ataviadas y compuestas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en los escombros metidas.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Como se iban descubriendo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 los perros se las com\'edan
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y tiraban de sus carnes
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 por el hambre que ten\'edan.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Las gentes apresuradas,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 a libertarse sal\'edan,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y los campos se poblaron
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de los pocos que exist\'edan.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 A las cuatro de la tarde
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 este espanto sucedi\'f3
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y el convento en el momento
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 se volvi\'f3 lamentaci\'f3n.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 A las veinte y cuatro horas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 fuimos de \'e9l arrojadas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 por un recado fingido
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que dio uno de los guardas.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'a1Oh, Dios qu\'e9 confusi\'f3n \'e9sta
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para las monjas del Carmen
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 sin pensar las de sus pr\'f3jimos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en fin en la calle se hallan!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Sin haberes, sin destino,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ni sin en d\'f3nde alojarse
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 salieron de su convento
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 poquito menos que a rastras
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 No s\'e9 si cuando ven\'edamos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en cielo o en tierra est\'e1bamos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues era tanto el espanto,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que a discurrir no acert\'e1bamos.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 La Priora, que por los a\'f1os
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ni andar puede sin trabajo,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en el medio de la calle
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 nos dice: \'93Yo estoy cansada;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ya yo no puedo seguir;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 arr\'e1strenme, se esto es dable,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 o busquen quienes en hombros
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 me lleven a acompa\'f1arlas\'94
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'a1Qu\'e9 apuraci\'f3n no ser\'eda
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para estas pobres monjitas,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues que ven que su Prelada
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que la carguen necesita!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 En fin, unos hombres ven
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 esta grande apuraci\'f3n
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y nos ofrecen que ellos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 la traer\'e1n entre los dos.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Una silla solicitan
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y la cargaron entre ambos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y nos preguntan en d\'f3nde
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pasaremos entre tanto.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Ellos dicen que si gustan
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que tienen unos solares,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que son los que poseemos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en el discurso de un a\'f1o.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Entramos ya por las puertas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de nuestra nueva mansi\'f3n
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y salen a recibirnos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 las bestias, \'a1gracias a Dios!
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 En una caballeriza
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 nos dicen que nos sentemos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 entre tanto discurrimos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que destino tomaremos;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 mas como nosotras nada
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pensar en \'e9sto podemos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 porque como dicho est\'e1
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ya discurrir no sabemos;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 los amos de los solares
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 nos dicen que nos sentemos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que un toldo que hemos tra\'eddo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ellos ofrecen ponerlo.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Por los lados nos los cubren
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 con las cosas de sus tiendas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 hasta que determinamos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 nuestro destino formal,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 porque ya la noche vino,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues cuando esto sucedi\'f3
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ya se estaba obscureciendo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y por eso nos ofrecen
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que de aqu\'ed ya no pasemos.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Un mes entero estuvimos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en aqueste alojamiento
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 expuestas al sol y al agua
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y a todo acontecimiento.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 En fin, formaron caney
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y ya convento tenemos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ya no hay porque afligirnos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en la aridez de este cerro.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Para que nada se quede
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ni en enigmas ni en bosquejos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 empezaremos el mapa
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 del convento que tenemos.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Este sitio es tan ameno
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y f\'e9rtil en producir,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que fueron tantas las plagas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 como ya voy a decir.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Clausura dicen que tengo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en el cerro del Calvario,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y entre tabla y tabla cabe
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 se\'f1a Chapona sentada.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Amarrada con cabuyas,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ni un poquitico delgada,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 al pie de \'e9sta est\'e1 la reja
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 con su muchito candado.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 M\'e1s arriba est\'e1 el postigo,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 la llave de mi tama\'f1o;
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'e9ste dicen que es el torno,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que es lugar muy reservado.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Tendr\'e1 media vara de ancho
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 el se\'f1or Locuteriado,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y del otro lado quedan
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 las escuchas duplicadas.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 La puerta del locutorio
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 es una grande frazada,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y la pieza que se sigue
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 es la cocina abreviada.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 De all\'ed se va al refectorio,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que de lienzo est\'e1 rodeado
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y aqueste es todo el convento
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en que estamos enclaustradas.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 La iglesia es de los seglares
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 pues tan ce\'f1idas estamos,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que una misa y nada m\'e1s
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 se nos dice reservada.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 A esta iglesia sigue un coro
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 tan hermoso y tan cuadrado
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que los santos contra el suelo
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 est\'e1n en \'e9l muy colgados.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 El nivel es tan hermoso
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que cuando nos confesarnos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 agarranos es preciso
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para no desapartarnos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 El rodar en \'e9l es f\'e1cil
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 y son tantos los pilares
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que no s\'e9 como hay narices
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 entre las monjas del Carmen.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Las celdas son tan hermosas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 tan unidas y arregladas,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que creo no estar\'e1n m\'e1s
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 las tejas en el tejado.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Sus techos son tan hermosos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 que a\'fan en el suelo paradas
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 sin estirarnos tocamos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ese grande entapizado.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Pensando estoy cuando un d\'eda
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 todas juntitas andemos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 por ser tantos los trabajos
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 para habernos de taparnos.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Los paramentos de iglesia,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 im\'e1genes y retablo,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 en una cocina sucia
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 han venido por guardados.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Y los dem\'e1s por el suelo,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de ratones muy rodeados,
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 ha sido m\'e1s que milagro
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 \'e9l haberse conservado.
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 Este es el mapa, se\'f1ores
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 del gran convento del Carmen
\f2\fs29\fsmilli14667 \cf0 \

\f0\fs34\fsmilli17333 \cf5 de descalzas recoletas
\f2\fs29\fsmilli14667 \cf0 \

